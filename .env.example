# Server
PORT=3000
NODE_ENV=development

# Session / security secrets - CHANGE THESE IN PRODUCTION
SESSION_SECRET=change_this_to_a_long_random_string
CSRF_SECRET=change_this_to_another_long_random_string

# Default admin account (created automatically on first run if no admin exists)
ADMIN_USERNAME=daniel
ADMIN_PASSWORD=voting

# Database
DB_PATH=./database/voting.db

# Where nominee photo uploads are stored. Leave unset for local dev
# (defaults to public/uploads). In production on a platform like Fly.io,
# point this at your mounted persistent volume, e.g. /data/uploads
UPLOAD_DIR=
